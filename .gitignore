# ═══════════════════════════════════════════════════════════════════════════════
# 🌱 rewildingCities .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

**/.data/
**/.envelope/
**/.envelopes/

# harvest outputs (regenerable)
harvest/reports/*
harvest/maps/*
harvest/exports/*
harvest/dashboards/*
!harvest/**/.gitkeep

# compost (logs accumulate locally)
compost/logs/*
compost/archive/*
!compost/**/.gitkeep

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# R artifacts
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# Terraform
# Unanchored (**/) so these apply to every terraform dir, not just the root one.
# A pattern containing a slash is anchored to this file's directory, which is why
# garden/experiments/in-the-cloud/terraform/ slipped through the old rules.
**/.terraform/
**/.terraform.tfstate.lock.info
**/*.tfstate
**/*.tfstate.backup
**/*.tfvars
!**/*.example.tfvars
# localstack.tfvars is all dummy values (account 000000000000, test@localhost);
# it is the worked example for local runs, so it stays tracked.
!**/localstack.tfvars

# system files
.DS_Store
Thumbs.db

# environment
.env
.env.localplots/**/.data/
*.joblib
*.pt
*.DNG
